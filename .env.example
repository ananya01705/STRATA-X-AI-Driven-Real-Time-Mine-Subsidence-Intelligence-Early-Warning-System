# ================================================================
# STRATA-X MINE SUBSIDENCE INTELLIGENCE SYSTEM — CONFIGURATION
# ================================================================

# Application
APP_NAME="STRATA-X Mine Subsidence Intelligence System"
APP_VERSION="2.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=false
CORS_ORIGINS=["*"]

# Offline Local Database (SQLite Edge Storage)
DATABASE_URL="sqlite:///backend/storage/mine_subsidence.db"

# Physical Hardware Anchor Node
REAL_SENSOR_NODE_ID="NODE_05"

# ML Time-to-Failure (TTF) Thresholds (Hours)
WINDOW_SIZE=30
TTF_CRITICAL_HOURS=1.0
TTF_HIGH_RISK_HOURS=3.0
TTF_WATCH_HOURS=6.0

# Kinematic Thresholds (mm/h and mm/h^2)
VELOCITY_THRESHOLD_HIGH=0.15
ACCELERATION_THRESHOLD_HIGH=0.05

# Sensor Fault Isolation & Communication Watchdog (Seconds)
SENSOR_FAULT_Z_SCORE_THRESHOLD=3.0
SENSOR_COMM_TIMEOUT_SECONDS=30.0

# Hardware Serial Ingestion (ESP32 / LoRa Bridge)
SERIAL_PORT="COM3"
SERIAL_BAUDRATE=115200
SERIAL_AUTO_RECONNECT=true
